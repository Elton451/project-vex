{
  "name": "project-vex",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run -parallel -filter \"./apps/**\" dev",
    "build": "pnpm run -recursive -filter \"./apps/**\" build",
    "test": "pnpm run -recursive -filter \"./apps/**\" test",
    "lint": "pnpm run -recursive -filter \"./apps/**\" lint",
    "format": "pnpm run -recursive -filter \"./apps/**\" prettier --write .",
    "prepare": "husky"
  },
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,scss,html,yaml,yml}": [
			"prettier --write"
		]
	},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.63.0"
  }
}
